# Configuración del servicio de mentorías (BackendNest.js).
# Ninguna credencial de proveedor es obligatoria: sin ella, solo ese proveedor
# responde 503 LIVE_PROVIDER_UNAVAILABLE. Nunca se versionan valores reales.

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=skillbridge_mentorship

# JWT RS256 emitido por el monolito (security.md)
JWT_PUBLIC_KEY=
JWT_ISSUER=skillbridge

# Cifrado en reposo de secretos de sala (AES-256-GCM)
LIVE_ROOM_ENCRYPTION_KEY=
LIVE_PROVIDER_TIMEOUT_MS=4000
LIVE_ROOM_TRANSACTION_TIMEOUT_MS=15000

# Zoom (OAuth Server-to-Server + Meeting SDK)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# Google Calendar (cuenta de servicio)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Discord (bot)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CATEGORY_ID=

# Observabilidad (NestJS Observe)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
